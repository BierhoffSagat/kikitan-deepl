{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "Kikitan DeepL fork",
    "publisher": "SAGAT",
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/kikitan_new.ico"
    ],
    "resources": [
      "./desktopoverlay"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "shortDescription": "Kikitan Translator with switchable DeepL and Google translation",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": false
  },
  "productName": "Kikitan Translator DeepL",
  "mainBinaryName": "kikitan-translator-deepl",
  "version": "1.2.5-deepl.9",
  "identifier": "com.sagat.kikitan.deepl",
  "plugins": {},
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "height": 525,
        "minHeight": 525,
        "minWidth": 900,
        "title": "Kikitan Translator DeepL",
        "width": 900
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data: https: blob:; media-src 'self' https: blob:; frame-src 'self' https:; child-src 'self' https:; connect-src 'self' https: http://localhost:* https://generativelanguage.googleapis.com https://gist.githubusercontent.com wss:; font-src 'self' https: data:;"
    }
  }
}
